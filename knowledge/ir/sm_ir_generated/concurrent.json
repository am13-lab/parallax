{
  "name": "Concurrent",
  "constructor": "NewConcurrentMachine",
  "init_state": "ConcIdle",
  "states": [
    {
      "name": "ConcIdle"
    },
    {
      "name": "ConcOneStream"
    },
    {
      "name": "ConcMultiStream"
    },
    {
      "name": "ConcAtLimit"
    },
    {
      "name": "ConcOverLimit",
      "terminal": true
    },
    {
      "name": "ConcCompleted",
      "terminal": true
    }
  ],
  "transitions": [
    {
      "from": "ConcIdle",
      "to": "ConcOneStream",
      "label": "conc_open_ping_stream",
      "weight": 10,
      "action": {
        "type": "ActOpenStream",
        "protocol": "/eth2/beacon_chain/req/ping/1/ssz_snappy",
        "payload": {
          "kind": "fields",
          "wrap": "ssz_snappy",
          "fields": {
            "value": {
              "lit": 1
            }
          }
        },
        "timeout_ms": 10000
      }
    },
    {
      "from": "ConcIdle",
      "to": "ConcOneStream",
      "label": "conc_open_bbr_stream",
      "weight": 8,
      "action": {
        "type": "ActOpenStream",
        "protocol": "/eth2/beacon_chain/req/beacon_blocks_by_range/2/ssz_snappy",
        "payload": {
          "kind": "fields",
          "wrap": "ssz_snappy",
          "fields": {
            "count": {
              "lit": 1
            },
            "start_slot": {
              "lit": 0
            }
          }
        },
        "timeout_ms": 10000
      }
    },
    {
      "from": "ConcIdle",
      "to": "ConcOneStream",
      "label": "conc_open_metadata_stream",
      "weight": 8,
      "action": {
        "type": "ActOpenStream",
        "protocol": "/eth2/beacon_chain/req/metadata/3/ssz_snappy",
        "timeout_ms": 10000
      }
    },
    {
      "from": "ConcOneStream",
      "to": "ConcMultiStream",
