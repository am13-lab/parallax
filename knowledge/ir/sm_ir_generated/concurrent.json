      "weight": 10,
      "action": {
        "type": "ActOpenStream",
        "protocol": "/eth2/beacon_chain/req/ping/1/ssz_snappy",
        "payload": {
          "kind": "fields",
          "wrap": "ssz_snappy",
          "fields": {
            "value": {
              "lit": 2
            }
          }
        },
        "timeout_ms": 10000
      }
    },
    {
      "from": "ConcMultiStream",
      "to": "ConcMultiStream",
      "label": "conc_open_additional_stream",
      "weight": 8,
      "condition_desc": "fewer than eight streams are currently open",
      "action": {
        "type": "ActOpenStream",
        "protocol": "/eth2/beacon_chain/req/ping/1/ssz_snappy",
        "payload": {
          "kind": "builder",
          "wrap": "ssz_snappy",
          "name": "buildPingStreamCountSSZ"
        },
        "timeout_ms": 10000
      },
      "guard": {
        "len": {
          "field": "open_streams",
          "op": "\u003c",
          "value": 8
        }
      }
    },
    {
      "from": "ConcMultiStream",
      "to": "ConcAtLimit",
      "label": "conc_fill_to_limit",
      "weight": 6,
      "condition_desc": "at least three streams are currently open",
      "action": {
        "type": "ActOpenStream",
        "protocol": "/eth2/beacon_chain/req/metadata/3/ssz_snappy",
        "timeout_ms": 10000
      },
      "guard": {
        "len": {
          "field": "open_streams",
          "op": "\u003e=",
          "value": 3
        }
      },
      "oracle": {
        "differential": true,
        "resource_bounds": {
          "max_fd_delta": 20
        }
      }
    },
    {
      "from": "ConcAtLimit",
      "to": "ConcOverLimit",
      "label": "conc_exceed_limit",
      "weight": 10,
      "spec_refs": [
        "PROSE-MUST_NOT-305625f9",
        "PROSE-MAY-c3746d81"
      ],
      "action": {
        "type": "ActOpenStream",
        "protocol": "/eth2/beacon_chain/req/ping/1/ssz_snappy",
        "payload": {
          "kind": "fields",
          "wrap": "ssz_snappy",
          "fields": {
            "value": {
              "lit": 99
            }
          }
        },
        "timeout_ms": 5000
      },
      "oracle": {
        "differential": true,
        "expected": "REJECT",
        "must_not": [
          "ACCEPT"
        ],
        "spec_predicate": "accepted == 0"
      }
    },
    {
      "from": "ConcMultiStream",
      "to": "ConcMultiStream",
      "label": "conc_read_latest",
      "weight": 6,
      "action": {
        "type": "ActReadResponse",
        "protocol": "/eth2/beacon_chain/req/ping/1/ssz_snappy",
        "timeout_ms": 10000
      }
    },
