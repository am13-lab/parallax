        "timeout_ms": 10000
      },
      "guard": {
        "len": {
          "field": "open_streams",
          "op": "\u003c",
          "value": 10
        }
      }
    },
    {
      "from": "ConcMultiStream",
      "to": "ConcMultiStream",
      "label": "conc_normal_ping_while_open",
      "weight": 4,
      "action": {
        "type": "ActSendReqResp",
        "protocol": "/eth2/beacon_chain/req/ping/1/ssz_snappy",
        "payload": {
          "kind": "fields",
          "wrap": "ssz_snappy",
          "fields": {
            "value": {
              "lit": 42
            }
          }
        },
        "timeout_ms": 5000
      }
    },
    {
      "from": "ConcMultiStream",
      "to": "ConcMultiStream",
      "label": "conc_check_connected",
      "weight": 2,
      "action": {
        "type": "ActCheckConnected",
        "timeout_ms": 5000
      }
    },
    {
      "from": "ConcAtLimit",
      "to": "ConcAtLimit",
      "label": "conc_check_at_limit",
      "weight": 3,
      "action": {
        "type": "ActCheckConnected",
        "timeout_ms": 5000
      }
    },
