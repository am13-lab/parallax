        "type": "ActSleep",
        "timeout_ms": 100
      }
    },
    {
      "from": "ConcMultiStream",
      "to": "ConcIdle",
      "label": "conc_drain_to_idle",
      "weight": 4,
      "condition_desc": "exactly one stream is currently open",
      "action": {
        "type": "ActReadResponse",
        "protocol": "/eth2/beacon_chain/req/ping/1/ssz_snappy",
        "timeout_ms": 10000
      },
      "guard": {
        "len": {
          "field": "open_streams",
          "op": "==",
          "value": 1
        }
      }
    },
    {
      "from": "ConcIdle",
      "to": "ConcIdle",
      "label": "conc_idle_delay",
      "weight": 3,
      "action": {
        "type": "ActSleep",
        "timeout_ms": 500
      }
    },
    {
      "from": "ConcOneStream",
      "to": "ConcOneStream",
      "label": "conc_write_without_close",
      "weight": 4,
      "spec_refs": [
        "PROSE-MUST-faaebe5c"
      ],
      "action": {
        "type": "ActWritePartial",
        "protocol": "/eth2/beacon_chain/req/ping/1/ssz_snappy",
