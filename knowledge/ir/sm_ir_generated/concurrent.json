      "action": {
        "type": "ActReadResponse",
        "protocol": "/eth2/beacon_chain/req/ping/1/ssz_snappy",
        "timeout_ms": 10000
      }
    },
    {
      "from": "ConcAtLimit",
      "to": "ConcMultiStream",
      "label": "conc_read_at_limit",
      "weight": 6,
      "action": {
        "type": "ActReadResponse",
        "protocol": "/eth2/beacon_chain/req/ping/1/ssz_snappy",
        "timeout_ms": 10000
      }
    },
    {
      "from": "ConcMultiStream",
      "to": "ConcMultiStream",
      "label": "conc_interleave_bbr",
      "weight": 5,
      "condition_desc": "fewer than ten streams are currently open",
      "action": {
        "type": "ActOpenStream",
        "protocol": "/eth2/beacon_chain/req/beacon_blocks_by_range/2/ssz_snappy",
        "payload": {
          "kind": "fields",
          "wrap": "ssz_snappy",
          "fields": {
            "count": {
              "lit": 1
            },
            "start_slot": {
              "lit": 0
            }
          }
